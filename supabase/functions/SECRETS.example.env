# Secrets das Edge Functions — configurar no painel Supabase:
# Settings > Edge Functions > Manage secrets

# ── Stripe ─────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_MONTHLY=price_...   # R$89,90/mês (assinatura recorrente)
STRIPE_PRICE_ANNUAL=price_...    # R$916,98/ano (cobrança única, PIX)

# ── Claude / Anthropic ────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Z-API ─────────────────────────────────────────────────────────────────
# Client-Token de segurança da sua conta Z-API
# Painel Z-API → Sua conta → Security Token
# (opcional mas recomendado para rejeitar webhooks não autorizados)
ZAPI_CLIENT_TOKEN=...
#
# ATENÇÃO: instanceId e instanceToken ficam no perfil de cada prestador
# (tabela profiles.whatsapp_instance e profiles.whatsapp_token)
# NÃO são secrets globais — cada cliente tem os seus.

# ── n8n (Tool Use — integrações externas) ────────────────────────────────
# Todos opcionais. Se não configurados, os agentes funcionam normalmente
# mas as ações externas (Calendar, fornecedores, Instagram) ficam em modo manual.

# Lucas — verifica disponibilidade no Google Calendar
N8N_CALENDAR_CHECK_URL=https://seu-n8n.com/webhook/calendar-check

# Lucas — cria evento no Google Calendar
N8N_CALENDAR_CREATE_URL=https://seu-n8n.com/webhook/calendar-create

# Otávio — envia pedido de cotação para fornecedores (WhatsApp/e-mail)
N8N_SUPPLIER_QUOTES_URL=https://seu-n8n.com/webhook/supplier-quotes

# Maya — agenda post no Instagram via API do Meta
N8N_INSTAGRAM_SCHEDULE_URL=https://seu-n8n.com/webhook/instagram-schedule
