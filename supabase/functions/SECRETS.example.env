# Secrets das Edge Functions — configurar no painel Supabase:
# Settings > Edge Functions > Manage secrets

# ── Stripe ─────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_MONTHLY=price_...   # R$89,90/mês (assinatura recorrente)
STRIPE_PRICE_ANNUAL=price_...    # R$916,98/ano (cobrança única, PIX)

# ── Claude / Anthropic ────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Z-API ─────────────────────────────────────────────────────────────────
# Client-Token de segurança da sua conta Z-API
# Painel Z-API → Sua conta → Security Token
# (opcional mas recomendado para rejeitar webhooks não autorizados)
ZAPI_CLIENT_TOKEN=...
#
# ATENÇÃO: instanceId e instanceToken ficam no perfil de cada marceneiro
# (tabela profiles.whatsapp_instance e profiles.whatsapp_token)
# NÃO são secrets globais — cada cliente tem os seus.
